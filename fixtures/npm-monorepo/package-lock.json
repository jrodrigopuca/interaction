{
  "name": "acme-monorepo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "acme-monorepo",
      "workspaces": [
        "packages/utils",
        "packages/core",
        "packages/api"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@acme/api": {
      "resolved": "packages/api",
      "link": true
    },
    "node_modules/@acme/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@acme/utils": {
      "resolved": "packages/utils",
      "link": true
    },
    "packages/api": {
      "name": "@acme/api",
      "version": "0.8.0",
      "dependencies": {
        "@acme/core": "^3.0.0"
      }
    },
    "packages/core": {
      "name": "@acme/core",
      "version": "3.0.1",
      "dependencies": {
        "@acme/utils": "^1.2.0"
      }
    },
    "packages/utils": {
      "name": "@acme/utils",
      "version": "1.2.0"
    }
  }
}
