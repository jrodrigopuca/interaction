# Run outputs. Each trace carries the full event stream, so these grow fast and
# are derived data, not source. Commit one deliberately (git add -f) when you
# want a behavioural baseline to diff future runs against.
runs/
runs-smoke/
# Runs made with another harness version (old format; viz.py does not read them).
runs-experiments/

